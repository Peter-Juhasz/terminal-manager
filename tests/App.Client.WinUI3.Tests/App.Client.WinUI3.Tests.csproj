<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppDirectory>..\..\src\App.Client.WinUI3\</AppDirectory>
  </PropertyGroup>

  <!-- A WinUI app can't be referenced by a test project, so the code under test, which doesn't depend on WinUI, is compiled in from it. -->
  <ItemGroup>
    <Compile Include="$(AppDirectory)Controls\OutputRunBuilder.cs" Link="App\Controls\OutputRunBuilder.cs" />
    <Compile Include="$(AppDirectory)Services\TerminalManagerScriptFile.cs" Link="App\Services\TerminalManagerScriptFile.cs" />
    <Compile Include="$(AppDirectory)Services\ScriptFileWatcher.cs" Link="App\Services\ScriptFileWatcher.cs" />
    <Compile Include="$(AppDirectory)Services\CommandRunner.cs" Link="App\Services\CommandRunner.cs" />
    <Compile Include="$(AppDirectory)Services\ElevationClient.cs" Link="App\Services\ElevationClient.cs" />
    <Compile Include="$(AppDirectory)Services\ElevationProtocol.cs" Link="App\Services\ElevationProtocol.cs" />
    <Compile Include="$(AppDirectory)Services\ElevationServer.cs" Link="App\Services\ElevationServer.cs" />
    <Compile Include="$(AppDirectory)Services\ScriptTemplate.cs" Link="App\Services\ScriptTemplate.cs" />
    <Compile Include="$(AppDirectory)Services\SettingsService.cs" Link="App\Services\SettingsService.cs" />
    <Compile Include="$(AppDirectory)Services\TextSearch.cs" Link="App\Services\TextSearch.cs" />
    <Compile Include="$(AppDirectory)Services\UrlDetector.cs" Link="App\Services\UrlDetector.cs" />
    <Compile Include="$(AppDirectory)ViewModels\CommandOutput.cs" Link="App\ViewModels\CommandOutput.cs" />
    <Compile Include="$(AppDirectory)ViewModels\OutputLineFilter.cs" Link="App\ViewModels\OutputLineFilter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.*" />
    <PackageReference Include="PeterJuhasz.Repositories.FileSystem" Version="2.*-*" />
    <PackageReference Include="PeterJuhasz.Repositories.Json" Version="1.*-*" />
    <PackageReference Include="PeterJuhasz.Text.Yaml" Version="1.*-*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App.Domain\App.Domain.csproj" />
    <ProjectReference Include="..\..\src\App.Services\App.Services.csproj" />
    <ProjectReference Include="..\..\src\App.Extensions.PowerShell\App.Extensions.PowerShell.csproj" />
    <ProjectReference Include="..\..\src\App.Extensions.Cmd\App.Extensions.Cmd.csproj" />
    <ProjectReference Include="..\..\src\App.Extensions.Azure\App.Extensions.Azure.csproj" />
    <ProjectReference Include="..\..\src\App.Extensions.Telnet\App.Extensions.Telnet.csproj" />
    <ProjectReference Include="..\..\src\App.Extensions.Node\App.Extensions.Node.csproj" />
  </ItemGroup>

</Project>
