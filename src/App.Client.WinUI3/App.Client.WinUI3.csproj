<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>App.Client.WinUI3</RootNamespace>
    <AssemblyName>terminal-manager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (no MSIX), and framework-dependent on the Windows App Runtime 2 installed on
         the machine rather than carrying its own copy. Current Windows 11 already has it, kept up
         to date by the Store for its own inbox apps (Notepad, Photos); where it is missing or older
         than the version built against, the bootstrapper offers to install it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- The P/Invoke signatures generated by CsWin32 use unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Main is in Program.cs, so the app can also be started as the elevated host. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Published ahead of time compiled, for a faster startup. -->
    <PublishAot>true</PublishAot>
    <!-- The native symbols are several times the size of the exe they describe. They are still
         written to the build output for local debugging, just not shipped. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- No WebView2 is ever created, so its WinRT component is not copied beside the exe. -->
    <WebView2EnableCsWinRTProjectionExcludeCoreRef>true</WebView2EnableCsWinRTProjectionExcludeCoreRef>
    <!-- Reports types given to WinRT that can't be with AOT, such as one that isn't partial, which would otherwise only show at runtime as a list left empty. -->
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- The XAML compiler of the experimental Windows App SDK generates code that uses its evaluation-only chart and tabular metadata providers. -->
    <NoWarn>$(NoWarn);CS8305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied, so it is found unpackaged too. -->
    <Content Include="Assets\pwsh.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\dotnet.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\python.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\node.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\azure-vm.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\docker.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\kubernetes.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\linux.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- From the Visual Studio Image Library. -->
    <Content Include="Assets\Completion\*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.*" />
    <!-- Generates the P/Invoke signatures listed in NativeMethods.txt. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <!-- Only the components the app uses rather than the Microsoft.WindowsAppSDK metapackage,
         whose ML component copies ONNX Runtime and DirectML (~40 MB) beside the exe even when the
         rest of the SDK comes from the installed runtime. Runtime is what makes it framework-dependent. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.*" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.*" />
    <!-- Brought in by WinUI for its WebView2 control, which the app does not use; referenced
         directly only to keep its native loader out of the output. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" ExcludeAssets="native" />
    <!-- Only preview builds are published so far. -->
    <PackageReference Include="PeterJuhasz.Repositories.FileSystem" Version="2.*-*" />
    <PackageReference Include="PeterJuhasz.Repositories.Json" Version="1.*-*" />
    <PackageReference Include="PeterJuhasz.Text.Yaml" Version="1.*-*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\App.Domain\App.Domain.csproj" />
    <ProjectReference Include="..\App.Services\App.Services.csproj" />
    <ProjectReference Include="..\App.Extensions.PowerShell\App.Extensions.PowerShell.csproj" />
    <ProjectReference Include="..\App.Extensions.Cmd\App.Extensions.Cmd.csproj" />
    <ProjectReference Include="..\App.Extensions.Azure\App.Extensions.Azure.csproj" />
    <ProjectReference Include="..\App.Extensions.Telnet\App.Extensions.Telnet.csproj" />
    <ProjectReference Include="..\App.Extensions.Node\App.Extensions.Node.csproj" />
  </ItemGroup>

  <!-- The referenced projects' managed symbols describe IL that native compilation has already
       folded into the exe, so they are of no use beside it. -->
  <Target Name="OmitReferencedSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- Every compiled XAML page is indexed into the project's PRI file rather than written beside
       the exe, and the WinUI targets copy that file to the build output without ever offering it
       to the publish pipeline — the hand-off they do have runs only for an MSIX package, which this
       app is not. Without it a published app dies inside InitializeComponent, before a window exists
       to say so: no dialog, nothing in the event log, exit code 0xC000027B. -->
  <Target Name="PublishProjectPriFile" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
