<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="App.Client.WinUI3.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="320" Spacing="16">
        <ComboBox
            x:Name="ThemeBox"
            HorizontalAlignment="Stretch"
            Header="Theme">
            <!-- In the order of the AppTheme enum. -->
            <ComboBoxItem Content="Use system setting" />
            <ComboBoxItem Content="Dark" />
            <ComboBoxItem Content="Light" />
        </ComboBox>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="The theme applies to the whole app as soon as you save."
            TextWrapping="Wrap" />
        <ToggleSwitch
            x:Name="WrapOutputSwitch"
            Header="Wrap long lines of output"
            OffContent="Off, scroll horizontally"
            OnContent="On" />
        <NumberBox
            x:Name="MaxOutputHeightBox"
            Header="Maximum height of output (pixels)"
            Minimum="40"
            PlaceholderText="No limit"
            SmallChange="50"
            LargeChange="200"
            SpinButtonPlacementMode="Compact" />
        <TextBlock
            Margin="0,-8,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="Longer output scrolls, and follows what is written last unless you scroll up. Leave it empty for no limit."
            TextWrapping="Wrap" />
        <ToggleSwitch
            x:Name="ConfirmTemplateScriptsSwitch"
            Header="Review script templates before running"
            OffContent="Off"
            OnContent="On, show the filled in command to confirm" />
        <InfoBar
            x:Name="SaveError"
            IsClosable="False"
            Severity="Error"
            Title="Couldn't save settings" />
    </StackPanel>
</ContentDialog>
