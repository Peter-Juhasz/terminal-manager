<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="App.Client.WinUI3.Views.ProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Client.WinUI3.Views"
    xmlns:models="using:App.Client.WinUI3.Models"
    xmlns:viewModels="using:App.Client.WinUI3.ViewModels"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- The terminal is picked before the dialog is shown, and can't be changed in it, so it is only told here. -->
    <ContentDialog.Title>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Content="{x:Bind local:Bind.TerminalIcon(ViewModel.Kind.IconUri, 32), Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Kind.DisplayName, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <!-- Wide enough for the navigation pane next to the page. -->
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
    </ContentDialog.Resources>

    <Grid Width="640">
        <!--
            Asks for the height the pages are shown at, but gives way to a window too short for it, where the pane and the page
            then each scroll on their own, rather than the dialog as a whole.
        -->
        <Border Height="360" />

        <!-- The selected page is set in code. -->
        <NavigationView
            x:Name="PageNavigation"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left">
            <NavigationView.Resources>
                <!-- The dialog is the surface, so the page doesn't need a layer of its own. -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralPageItem" Content="General">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="EnvironmentVariablesPageItem" Content="Environment variables">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                    <!-- Tells why the project can't be saved while another page is shown. -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{ThemeResource CriticalIconInfoBadgeStyle}" Visibility="{x:Bind ViewModel.HasEnvironmentVariablesError, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <!-- Only projects run by PowerShell or a shell, or whose commands are code, have them, and the terminal can't be changed from this page. -->
                <NavigationViewItem
                    x:Name="ScriptsPageItem"
                    Content="Prepend and append"
                    Visibility="{x:Bind ViewModel.HasPrependAndAppend, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="HistoryPageItem" Content="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Margin="24,0,0,0" Padding="0,0,16,0">
                <Grid>
                    <StackPanel Spacing="16" Visibility="{x:Bind GeneralPageItem.IsSelected, Mode=OneWay}">
                        <TextBox
                            x:Name="DisplayNameBox"
                            Header="Name"
                            PlaceholderText="My project"
                            Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="{x:Bind ViewModel.WorkingFolderHeader, Mode=OneWay}"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="{x:Bind ViewModel.WorkingFolderPlaceholder, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.WorkingFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <!-- A folder elsewhere can't be browsed for here. -->
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Click="OnBrowseClick"
                                    Content="Browse…"
                                    Visibility="{x:Bind ViewModel.IsWorkingFolderLocal, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="The folder doesn't exist."
                                Visibility="{x:Bind ViewModel.IsWorkingFolderMissing, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Only projects run on an Azure virtual machine have them. -->
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsAzureVm, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Subscription"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="Name or id"
                                    Text="{x:Bind ViewModel.Subscription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Leave it empty for the default subscription of the Azure CLI."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox
                                Header="Resource group"
                                IsSpellCheckEnabled="False"
                                PlaceholderText="my-resource-group"
                                Text="{x:Bind ViewModel.ResourceGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Virtual machine"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="my-vm"
                                    Text="{x:Bind ViewModel.VmName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Each command is run by az vm run-command invoke, as root or the local system account, in the working folder on the machine. Its output is shown once it ended."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Only projects run by PowerShell remoting have it. -->
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsPowerShellRemoting, Mode=OneWay}">
                            <TextBox
                                Header="Computer name"
                                IsSpellCheckEnabled="False"
                                PlaceholderText="server01.contoso.com"
                                Text="{x:Bind ViewModel.ComputerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Each command is run by Invoke-Command, in a session of its own, as you, in the working folder on the computer. The computer needs to have PowerShell remoting enabled."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Only projects run by WSL have them. -->
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsWsl, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Distribution"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="Ubuntu"
                                    Text="{x:Bind ViewModel.Distribution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Its name, as wsl --list shows it. Leave it empty for the default distribution."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="User"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="root"
                                    Text="{x:Bind ViewModel.User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Leave it empty for the default user of the distribution. Each command is run by wsl.exe, as a script of a login bash, in the working folder: a folder of Windows, such as C:\src\app, is opened as /mnt/c/src/app, and a folder of Linux, such as ~/src/app, is changed to first. The .env file is only read from a folder of Windows."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Only projects run in a Docker container have them. -->
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsDocker, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Container"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="Name or id"
                                    Text="{x:Bind ViewModel.Container, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ContainerDescription, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="User"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="name or uid:gid"
                                    Text="{x:Bind ViewModel.User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Leave it empty for the user of the container."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Context"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="default"
                                    Text="{x:Bind ViewModel.Context, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Leave it empty for the current context of the Docker CLI."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Only projects run in a container of a Kubernetes pod have them. -->
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsKubectl, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Pod"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="my-pod or deploy/my-app"
                                    Text="{x:Bind ViewModel.Pod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ContainerDescription, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Container"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="my-container"
                                    Text="{x:Bind ViewModel.Container, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Leave it empty for the default container of the pod."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Namespace"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="default"
                                    Text="{x:Bind ViewModel.Namespace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Leave it empty for the namespace of the context."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBox
                                    Header="Context"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="my-cluster"
                                    Text="{x:Bind ViewModel.Context, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Leave it empty for the current context of kubectl."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Only projects run by dotnet run, or by an interpreter, have them. -->
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasArguments, Mode=OneWay}">
                            <TextBox
                                FontFamily="{StaticResource MonospaceFontFamily}"
                                Header="{x:Bind ViewModel.ArgumentsHeader, Mode=OneWay}"
                                IsSpellCheckEnabled="False"
                                PlaceholderText="{x:Bind ViewModel.ArgumentsPlaceholder, Mode=OneWay}"
                                Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ArgumentsDescription, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8" Visibility="{x:Bind EnvironmentVariablesPageItem.IsSelected, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.EnvironmentVariablesDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <!-- A .env file is only read from a folder on this machine. -->
                        <CheckBox IsChecked="{x:Bind ViewModel.LoadEnvFile, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsWorkingFolderLocal, Mode=OneWay}">
                            <TextBlock Text="Load from .env file" TextWrapping="Wrap" />
                        </CheckBox>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EnvironmentVariables}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:EnvironmentVariableEditorViewModel">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            AutomationProperties.Name="Name"
                                            FontFamily="{StaticResource MonospaceFontFamily}"
                                            PlaceholderText="NAME"
                                            Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="1"
                                            AutomationProperties.Name="Value"
                                            FontFamily="{StaticResource MonospaceFontFamily}"
                                            PlaceholderText="Value"
                                            Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="Remove"
                                            Command="{x:Bind RemoveCommand}"
                                            ToolTipService.ToolTip="Remove">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.EnvironmentVariablesError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasEnvironmentVariablesError, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.AddEnvironmentVariableCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                                <TextBlock Text="Add variable" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="16" Visibility="{x:Bind ScriptsPageItem.IsSelected, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ScriptsDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBox
                            MinHeight="96"
                            MaxHeight="200"
                            AcceptsReturn="True"
                            FontFamily="{StaticResource MonospaceFontFamily}"
                            Header="Prepend script"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="{x:Bind ViewModel.PrependScriptPlaceholder, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.PrependScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBox
                            MinHeight="96"
                            MaxHeight="200"
                            AcceptsReturn="True"
                            FontFamily="{StaticResource MonospaceFontFamily}"
                            Header="Append script"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="{x:Bind ViewModel.AppendScriptPlaceholder, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.AppendScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind HistoryPageItem.IsSelected, Mode=OneWay}">
                        <CheckBox IsChecked="{x:Bind ViewModel.PersistHistory, Mode=TwoWay}">
                            <TextBlock Text="Keep history" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="The commands that were run, with what they wrote, are saved, and shown again after the app is started."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</ContentDialog>
