<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="App.Client.WinUI3.Views.ProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Client.WinUI3.Views"
    xmlns:models="using:App.Client.WinUI3.Models"
    xmlns:viewModels="using:App.Client.WinUI3.ViewModels"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="440" Spacing="16">
        <ComboBox
            HorizontalAlignment="Stretch"
            Header="Terminal"
            IsEnabled="{x:Bind ViewModel.IsNew}"
            ItemsSource="{x:Bind ViewModel.Kinds}"
            SelectedItem="{x:Bind ViewModel.Kind, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:ProjectKind">
                    <TextBlock Text="{x:Bind DisplayName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox
            x:Name="DisplayNameBox"
            Header="Name"
            PlaceholderText="My project"
            Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="Working folder"
                    PlaceholderText="C:\src\my-project"
                    Text="{x:Bind ViewModel.WorkingFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="OnBrowseClick"
                    Content="Browse…" />
            </Grid>
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="The folder doesn't exist."
                Visibility="{x:Bind ViewModel.IsWorkingFolderMissing, Mode=OneWay}" />
        </StackPanel>

        <Expander
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="{x:Bind ViewModel.EnvironmentVariablesHeader, Mode=OneWay}"
            IsExpanded="False">
            <StackPanel Spacing="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Commands are run with these, in addition to the variables of the app. Use %NAME% in a value to include another variable."
                    TextWrapping="Wrap" />
                <CheckBox IsChecked="{x:Bind ViewModel.LoadEnvFile, Mode=TwoWay}">
                    <TextBlock Text="Load from .env file" TextWrapping="Wrap" />
                </CheckBox>
                <ItemsControl ItemsSource="{x:Bind ViewModel.EnvironmentVariables}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:EnvironmentVariableEditorViewModel">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.Name="Name"
                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                    PlaceholderText="NAME"
                                    Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Value"
                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                    PlaceholderText="Value"
                                    Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="2"
                                    AutomationProperties.Name="Remove"
                                    Command="{x:Bind RemoveCommand}"
                                    ToolTipService.ToolTip="Remove">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.EnvironmentVariablesError, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasEnvironmentVariablesError, Mode=OneWay}" />
                <Button Command="{x:Bind ViewModel.AddEnvironmentVariableCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock Text="Add variable" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Expander>

        <Expander
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="{x:Bind ViewModel.ScriptsHeader, Mode=OneWay}"
            IsExpanded="False"
            Visibility="{x:Bind ViewModel.IsPowerShell, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Run before and after each command, in the same scope, so what the prepend script defines can be used by commands, and is offered by completion."
                    TextWrapping="Wrap" />
                <TextBox
                    MaxHeight="200"
                    AcceptsReturn="True"
                    FontFamily="{StaticResource MonospaceFontFamily}"
                    Header="Prepend script"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="Import-Module ./build.psm1"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.PrependScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBox
                    MaxHeight="200"
                    AcceptsReturn="True"
                    FontFamily="{StaticResource MonospaceFontFamily}"
                    Header="Append script"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="Write-Host &quot;Exit code: $LASTEXITCODE&quot;"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.AppendScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Expander>
    </StackPanel>
</ContentDialog>
