<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="App.Client.WinUI3.Views.TerminalPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Client.WinUI3.Views"
    xmlns:models="using:App.Client.WinUI3.Models"
    Title="New project"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <!-- Wide enough for two columns of terminals. -->
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        <!-- The terminals, grouped by whether they run on this machine or elsewhere. -->
        <CollectionViewSource
            x:Name="KindsSource"
            IsSourceGrouped="True"
            Source="{x:Bind KindGroups}" />
    </ContentDialog.Resources>

    <StackPanel Width="720" Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Choose the terminal the commands of the project are run by."
            TextWrapping="Wrap" />

        <!-- A terminal is picked by clicking it, which goes on to the project. -->
        <GridView
            x:Name="KindsView"
            MaxHeight="480"
            IsItemClickEnabled="True"
            ItemClick="OnKindClick"
            ItemsSource="{x:Bind KindsSource.View}"
            SelectionMode="None">
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:ProjectKindGroup">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ProjectKind">
                    <!-- Tall enough for a name and a description of two lines each, so none is cut off, and all start at the top alike. -->
                    <Grid
                        Width="352"
                        Height="100"
                        Padding="12"
                        AutomationProperties.Name="{x:Bind DisplayName}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Top" Content="{x:Bind local:Bind.TerminalIcon(IconUri, 32)}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Spacing="4">
                            <TextBlock
                                MaxLines="2"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </StackPanel>
</ContentDialog>
