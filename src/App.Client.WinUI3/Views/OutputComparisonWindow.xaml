<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App.Client.WinUI3.Views.OutputComparisonWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Client.WinUI3.Controls"
    xmlns:local="using:App.Client.WinUI3.Views"
    xmlns:services="using:App.Services">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="WindowTitleBar" Title="{x:Bind local:Bind.Format('Compare · {0}', ViewModel.Title)}">
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <SvgImageSource UriSource="ms-appx:///Assets/AppIcon.svg" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Moving between the changes, and what is ignored when lines are compared; and across from them, how many lines differ.  -->
        <CommandBar
            Grid.Row="1"
            Margin="8,0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <AppBarButton
                Click="OnPreviousChangeClick"
                IsEnabled="{x:Bind local:Bind.Not(ViewModel.HasNoChanges), Mode=OneWay}"
                Label="Previous change"
                ToolTipService.ToolTip="Previous change (Shift+F7)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74A;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F7" Modifiers="Shift" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                Click="OnNextChangeClick"
                IsEnabled="{x:Bind local:Bind.Not(ViewModel.HasNoChanges), Mode=OneWay}"
                Label="Next change"
                ToolTipService.ToolTip="Next change (F7)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74B;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F7" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarToggleButton
                IsChecked="{x:Bind ViewModel.IgnoreWhitespace, Mode=TwoWay}"
                Label="Ignore whitespace"
                ToolTipService.ToolTip="Lines that differ only in spaces and tabs are the same">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE75D;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                IsChecked="{x:Bind ViewModel.IgnoreCase, Mode=TwoWay}"
                Label="Ignore case"
                ToolTipService.ToolTip="Lines that differ only in upper and lower case are the same">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8D2;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                IsChecked="{x:Bind ViewModel.IgnoreNumbers, Mode=TwoWay}"
                Label="Ignore numbers"
                ToolTipService.ToolTip="Lines that differ only in numbers, such as durations and times, are the same">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8EF;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
        </CommandBar>

        <!--  On the right, across from the commands, as the content of the command bar is shown on its left.  -->
        <StackPanel
            Grid.Row="1"
            Margin="16,0,24,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsComparing, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsComparing, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            Margin="16,0,16,8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsApproximate, Mode=OneWay}"
            Message="The outputs differ in too many lines to find the fewest changes between them, so some lines may be shown changed that are the same."
            Severity="Warning" />
        <InfoBar
            Grid.Row="2"
            Margin="16,0,16,8"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
            Severity="Error"
            Title="The outputs couldn't be compared" />

        <!--  What was run on each side, and when.  -->
        <Grid
            Grid.Row="3"
            Margin="17,0,17,0"
            Padding="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="56,0,12,0" Spacing="2">
                <TextBlock
                    FontFamily="{StaticResource MonospaceFontFamily}"
                    Text="{x:Bind ViewModel.Left.Command}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Left.Command}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Left.Description}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Padding="56,0,12,0"
                Spacing="2">
                <TextBlock
                    FontFamily="{StaticResource MonospaceFontFamily}"
                    Text="{x:Bind ViewModel.Right.Command}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Right.Command}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Right.Description}" />
            </StackPanel>
        </Grid>

        <!--
            The rows of both sides in one list, so they scroll together, and a line wrapped on one side keeps the row as high on the other.
            Only the rows in view are laid out, so long outputs scroll as quickly as short ones.
        -->
        <Border
            Grid.Row="4"
            Margin="16,0,16,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer
                x:Name="RowsScroller"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!--  Its rows are set by the window, as a list of a type WinRT can be given only when it is known where it is set.  -->
                <ItemsRepeater x:Name="RowsRepeater" Margin="0,4">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="services:DiffRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  The backgrounds of the line removed on the left, and added on the right, or of where a side has no line.  -->
                                <Border
                                    Grid.ColumnSpan="2"
                                    Background="{ThemeResource DiffRemovedLineBrush}"
                                    Visibility="{x:Bind local:Bind.RemovedIf(Kind)}" />
                                <Border
                                    Grid.ColumnSpan="2"
                                    Background="{ThemeResource DiffFillerBrush}"
                                    Visibility="{x:Bind local:Bind.LeftFillerIf(Kind)}" />
                                <Border
                                    Grid.Column="3"
                                    Grid.ColumnSpan="2"
                                    Background="{ThemeResource DiffAddedLineBrush}"
                                    Visibility="{x:Bind local:Bind.AddedIf(Kind)}" />
                                <Border
                                    Grid.Column="3"
                                    Grid.ColumnSpan="2"
                                    Background="{ThemeResource DiffFillerBrush}"
                                    Visibility="{x:Bind local:Bind.RightFillerIf(Kind)}" />

                                <TextBlock
                                    Padding="0,1,12,1"
                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind local:Bind.LineNumber(Left)}"
                                    TextAlignment="Right" />
                                <TextBlock
                                    Grid.Column="1"
                                    Padding="0,1,12,1"
                                    controls:DiffHighlighting.RemovedLine="{x:Bind Left}"
                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                    FontSize="13"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />

                                <Rectangle Grid.Column="2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <TextBlock
                                    Grid.Column="3"
                                    Padding="0,1,12,1"
                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind local:Bind.LineNumber(Right)}"
                                    TextAlignment="Right" />
                                <TextBlock
                                    Grid.Column="4"
                                    Padding="0,1,12,1"
                                    controls:DiffHighlighting.AddedLine="{x:Bind Right}"
                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                    FontSize="13"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
