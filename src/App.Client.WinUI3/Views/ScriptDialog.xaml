<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="App.Client.WinUI3.Views.ScriptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="440" Spacing="16">
        <TextBox
            x:Name="NameBox"
            Header="Name"
            PlaceholderText="Build"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox
            MinHeight="96"
            MaxHeight="240"
            AcceptsReturn="True"
            FontFamily="{StaticResource MonospaceFontFamily}"
            Header="Command"
            IsSpellCheckEnabled="False"
            IsTextPredictionEnabled="False"
            PlaceholderText="dotnet build"
            Text="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <CheckBox IsChecked="{x:Bind ViewModel.IsTemplate, Mode=TwoWay}">
            <TextBlock Text="Expand template variables" TextWrapping="Wrap" />
        </CheckBox>
    </StackPanel>
</ContentDialog>
