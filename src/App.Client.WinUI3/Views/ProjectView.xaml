<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Client.WinUI3.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Client.WinUI3.Controls"
    xmlns:local="using:App.Client.WinUI3.Views"
    xmlns:models="using:App.Client.WinUI3.Models"
    xmlns:vm="using:App.Client.WinUI3.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="CommandEntryTemplate" x:DataType="vm:CommandEntryViewModel">
            <StackPanel Margin="0,10" Spacing="6">

                <!--  The command, on the right, as what the user said in a chat.  -->
                <Border
                    MaxWidth="720"
                    Padding="14,10"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="14,14,4,14">
                    <TextBlock
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Command}"
                        TextWrapping="Wrap" />
                </Border>

                <!--  What it wrote, with the standard error in red, as it is written.  -->
                <Border
                    Padding="14,10"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind IsOutputVisible, Mode=OneWay}">
                    <RichTextBlock
                        controls:TerminalOutput.Segments="{x:Bind Segments}"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        FontSize="13"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </Border>

                <!--  How it ended, and how long it took.  -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind IsRunning, Mode=OneWay}"
                        Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind IsSucceeded, Mode=OneWay}" />
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE711;"
                        Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}" />
                    <ProgressBar
                        Width="120"
                        VerticalAlignment="Center"
                        IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                        Maximum="100"
                        ShowError="{x:Bind IsProgressError, Mode=OneWay}"
                        ShowPaused="{x:Bind IsProgressPaused, Mode=OneWay}"
                        Visibility="{x:Bind IsProgressVisible, Mode=OneWay}"
                        Value="{x:Bind ProgressValue, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="·" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind DurationText, Mode=OneWay}" />
                    <Button
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Stop"
                        Command="{x:Bind StopCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Stop"
                        Visibility="{x:Bind IsRunning, Mode=OneWay}">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE71A;" />
                    </Button>
                    <Button
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Copy output"
                        Command="{x:Bind CopyCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Copy output"
                        Visibility="{x:Bind HasOutput, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        Margin="-8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ExpandToolTip, Mode=OneWay}"
                        Command="{x:Bind ToggleExpandedCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ExpandToolTip, Mode=OneWay}"
                        Visibility="{x:Bind HasOutput, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Header  -->
        <Grid
            Padding="32,20,24,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Session.Project.DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Session.Project.TerminalDisplayName, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Session.Project.WorkingFolder, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    AutomationProperties.Name="Open working folder"
                    Click="OnOpenFolderClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Open working folder">
                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                </Button>
                <Button
                    AutomationProperties.Name="Clear history"
                    Command="{x:Bind Session.ClearCommand, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Clear history">
                    <FontIcon FontSize="16" Glyph="&#xE894;" />
                </Button>
                <Button
                    x:Name="ScriptsToggleButton"
                    AutomationProperties.Name="Hide scripts"
                    Click="OnToggleScriptsClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Hide scripts">
                    <FontIcon
                        x:Name="ScriptsToggleIcon"
                        FontSize="16"
                        Glyph="&#xE89F;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  History; anchored to the bottom, so output that is being written stays in view.  -->
        <ScrollViewer
            x:Name="HistoryScroller"
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            VerticalAnchorRatio="1"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                Margin="32,0,32,12"
                ItemTemplate="{StaticResource CommandEntryTemplate}"
                ItemsSource="{x:Bind Session.Entries, Mode=OneWay}" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:Bind.CollapsedIf(Session.HasEntries), Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Run a command" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Type a command below, and it is run in the working folder of the project. Its output is shown here as it is written."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Composer; the text box carries the border, and the buttons sit on top of it.  -->
        <Grid Grid.Row="2" Padding="32,8,32,20">
            <TextBox
                x:Name="InputBox"
                MinHeight="56"
                MaxHeight="200"
                Padding="12,17,60,10"
                AcceptsReturn="True"
                AutomationProperties.Name="Command"
                CornerRadius="12"
                FontFamily="{StaticResource MonospaceFontFamily}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                PlaceholderText="Type a command — Enter to run, Shift+Enter for a new line"
                PreviewKeyDown="OnInputPreviewKeyDown"
                Text="{x:Bind Session.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <!--  Commands can be run while others are running; each is stopped from its own item.  -->
            <Button
                Width="40"
                Height="40"
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Run"
                Command="{x:Bind Session.RunCommand, Mode=OneWay}"
                CornerRadius="10"
                Style="{ThemeResource AccentButtonStyle}"
                ToolTipService.ToolTip="Run (Enter)">
                <FontIcon FontSize="16" Glyph="&#xE724;" />
            </Button>
        </Grid>

        <!--  Saved scripts, each run with a single click, and edited or deleted from its menu.  -->
        <Grid
            x:Name="ScriptsPane"
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="280"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="20,24,12,12">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Scripts" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Save script"
                    Click="OnAddScriptClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Save a script; what is typed in the input is filled in">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="8,0,8,12">
                <ItemsRepeater ElementPrepared="OnScriptElementPrepared" ItemsSource="{x:Bind Session.Scripts, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedScript">
                            <!--  The menu is on the item rather than the button, so it is available whatever the state of the button.  -->
                            <Grid>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="OnEditScriptClick"
                                            Tag="{x:Bind}"
                                            Text="Edit">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="OnDeleteScriptClick"
                                            Tag="{x:Bind}"
                                            Text="Delete">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <!--  Its command is the session's, set when the item is prepared.  -->
                                <Button
                                    Padding="12,8,40,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    CommandParameter="{x:Bind}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind Command}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Margin="0,3,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="12"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE768;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonospaceFontFamily}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Command}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button
                                    Margin="0,4,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{x:Bind local:Bind.Format('More options for {0}', Name)}"
                                    Click="OnScriptMoreClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="More options">
                                    <FontIcon FontSize="12" Glyph="&#xE712;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock
                Grid.Row="1"
                Margin="20,0,20,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Save commands you run often, and run them here with a single click."
                TextWrapping="Wrap"
                Visibility="{x:Bind local:Bind.CollapsedIf(Session.HasScripts), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
