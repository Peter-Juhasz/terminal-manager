<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Client.WinUI3.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Client.WinUI3.Controls"
    xmlns:local="using:App.Client.WinUI3.Views"
    xmlns:models="using:App.Client.WinUI3.Models"
    xmlns:services="using:App.Client.WinUI3.Services"
    xmlns:vm="using:App.Client.WinUI3.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="CommandEntryTemplate" x:DataType="vm:CommandEntryViewModel">
            <!--  As a cell of a notebook: the command, and below it what it wrote, on a single card.  -->
            <Border
                Margin="0,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  The command, with when it was started, and the command copied or run again, and the output collapsed beside it.  -->
                    <Grid Padding="14,6,6,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RichTextBlock
                            x:Name="CommandText"
                            Margin="0,4"
                            controls:SyntaxHighlighting.Code="{x:Bind HighlightedCommand, Mode=OneWay}"
                            FontFamily="{StaticResource MonospaceFontFamily}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="0">
                            <FontIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Run as administrator"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xEA18;"
                                ToolTipService.ToolTip="Run as administrator"
                                Visibility="{x:Bind IsElevated}" />
                            <TextBlock
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind StartedAtText}"
                                ToolTipService.ToolTip="{x:Bind StartedAtToolTip}" />
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind PinToolTip, Mode=OneWay}"
                                Command="{x:Bind TogglePinnedCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind PinToolTip, Mode=OneWay}">
                                <Grid>
                                    <FontIcon
                                        FontSize="12"
                                        Glyph="&#xE718;"
                                        Visibility="{x:Bind IsNotPinned, Mode=OneWay}" />
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE841;"
                                        Visibility="{x:Bind IsPinned, Mode=OneWay}" />
                                </Grid>
                            </Button>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Copy command"
                                Command="{x:Bind CopyInputCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Copy command">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Run again"
                                Command="{x:Bind RerunCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Run again">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Save as script"
                                Click="OnSaveAsScriptClick"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Save as script">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Remove from history"
                                Click="OnRemoveEntryClick"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Remove from history"
                                Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                            </Button>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind ExpandToolTip, Mode=OneWay}"
                                Command="{x:Bind ToggleExpandedCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ExpandToolTip, Mode=OneWay}"
                                Visibility="{x:Bind HasOutput, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  What it wrote, with the standard error in red, as it is written; and below it, how it ended.  -->
                    <StackPanel
                        Grid.Row="2"
                        Padding="14,10,14,6"
                        Spacing="8">
                        <!--  Scrolled horizontally only when long lines aren't wrapped, and vertically only when its height is limited, as set by the view.  -->
                        <ScrollViewer
                            x:Name="OutputScroller"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled"
                            Visibility="{x:Bind IsOutputVisible, Mode=OneWay}">
                            <RichTextBlock
                                x:Name="OutputText"
                                controls:TerminalOutput.Output="{x:Bind Output}"
                                FontFamily="{StaticResource MonospaceFontFamily}"
                                FontSize="13"
                                IsTextSelectionEnabled="True"
                                SizeChanged="OnOutputTextSizeChanged"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <!--  How it ended, and how long it took.  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind IsSucceeded, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE711;"
                                Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}" />
                            <ProgressBar
                                Width="120"
                                VerticalAlignment="Center"
                                IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                Maximum="100"
                                ShowError="{x:Bind IsProgressError, Mode=OneWay}"
                                ShowPaused="{x:Bind IsProgressPaused, Mode=OneWay}"
                                Visibility="{x:Bind IsProgressVisible, Mode=OneWay}"
                                Value="{x:Bind ProgressValue, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="·" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind DurationText, Mode=OneWay}" />
                            <Button
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Stop"
                                Command="{x:Bind StopCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Stop"
                                Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE71A;" />
                            </Button>
                            <Button
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Copy output"
                                Command="{x:Bind CopyCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Copy output"
                                Visibility="{x:Bind HasOutput, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                Margin="-8,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Save output to file"
                                Click="OnSaveOutputClick"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Save output to file"
                                Visibility="{x:Bind HasOutput, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE74E;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Header  -->
        <Grid
            Padding="32,20,24,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Session.Project.DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Session.Project.TerminalDisplayName, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Session.Project.WorkingFolder, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <!--  What is searched for in the history, while the search is on.  -->
                <TextBox
                    x:Name="SearchBox"
                    Width="240"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search history"
                    KeyDown="OnSearchBoxKeyDown"
                    PlaceholderText="Search history"
                    TextChanged="OnSearchTextChanged"
                    Visibility="Collapsed" />
                <ToggleButton
                    x:Name="SearchToggleButton"
                    AutomationProperties.Name="Search history"
                    Click="OnToggleSearchClick"
                    Style="{StaticResource IconToggleButtonStyle}"
                    ToolTipService.ToolTip="Search history">
                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                </ToggleButton>
                <Button
                    AutomationProperties.Name="Open working folder"
                    Click="OnOpenFolderClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Open working folder">
                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                </Button>
                <Button
                    x:Name="ScriptsToggleButton"
                    AutomationProperties.Name="Hide scripts"
                    Click="OnToggleScriptsClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Hide scripts">
                    <FontIcon
                        x:Name="ScriptsToggleIcon"
                        FontSize="16"
                        Glyph="&#xE89F;" />
                </Button>
                <Button
                    AutomationProperties.Name="More options"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="More options">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind Session.ClearUnpinnedCommand, Mode=OneWay}" Text="Clear history except pinned">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE718;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Session.ClearCommand, Mode=OneWay}" Text="Clear history">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE894;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnEditProjectClick" Text="Edit project">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnDeleteProjectClick" Text="Delete project">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  History; anchored to the bottom, so output that is being written stays in view.  -->
        <ScrollViewer
            x:Name="HistoryScroller"
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            VerticalAnchorRatio="1"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                x:Name="HistoryRepeater"
                Margin="32,0,32,12"
                ElementPrepared="OnEntryElementPrepared"
                ItemTemplate="{StaticResource CommandEntryTemplate}"
                ItemsSource="{x:Bind Session.Entries, Mode=OneWay}" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:Bind.CollapsedIf(Session.HasEntries), Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Run a command" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Type a command below, and it is run in the working folder of the project. Its output is shown here as it is written."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Composer; the text box carries the border, and the buttons sit on top of it. The commands queued are listed above it.  -->
        <Grid
            Grid.Row="2"
            Padding="32,8,32,20"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4" Visibility="{x:Bind Session.HasQueue, Mode=OneWay}">
                <TextBlock
                    Margin="4,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Queued — each is run once the commands running have ended" />
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater ItemsSource="{x:Bind Session.Queue, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueuedCommand">
                                <Grid
                                    Padding="12,2,4,2"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="10"
                                    CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE823;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource MonospaceFontFamily}"
                                        Text="{x:Bind Command}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Command}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Cancel"
                                        Click="OnCancelQueuedClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Cancel">
                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>

            <TextBox
                Grid.Row="1"
                x:Name="InputBox"
                MinHeight="56"
                MaxHeight="200"
                Padding="12,17,96,10"
                AcceptsReturn="True"
                AutomationProperties.Name="Command"
                CornerRadius="12"
                FontFamily="{StaticResource MonospaceFontFamily}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                PlaceholderText="Type a command"
                LostFocus="OnInputLostFocus"
                PreviewKeyDown="OnInputPreviewKeyDown"
                SelectionChanged="OnInputSelectionChanged"
                Text="{x:Bind Session.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <!--
                The matches the text before the caret can be completed to, opened by Ctrl+Space above the text completed.
                The focus is left on the input, which moves through the matches with the arrow keys, so the list is never focused, not even by a click.
            -->
            <Popup
                x:Name="CompletionPopup"
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Border
                    Width="420"
                    Padding="0,4"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <ListView
                        x:Name="CompletionList"
                        MaxHeight="280"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Completions"
                        IsItemClickEnabled="True"
                        IsTabStop="False"
                        ItemClick="OnCompletionItemClick"
                        Loaded="OnCompletionListLoaded"
                        SelectionChanged="OnCompletionSelectionChanged"
                        SelectionMode="Single">
                        <!--  refreshed on each key typed, so the matches are replaced at once, not animated in  -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:CompletionMatch">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ImageIcon
                                        Width="16"
                                        Height="16"
                                        Source="{x:Bind local:Bind.CompletionIcon(ResultType)}" />
                                    <TextBlock
                                        controls:CompletionHighlighting.Match="{x:Bind}"
                                        FontFamily="{StaticResource MonospaceFontFamily}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Popup>

            <!--  What the match selected is, such as the syntax of a command, or the full path of a file, beside it, as Visual Studio shows it.  -->
            <Popup x:Name="CompletionInfoPopup" DesiredPlacement="RightEdgeAlignedTop">
                <Border
                    MaxWidth="400"
                    Margin="8,0,0,0"
                    Padding="12,8"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <TextBlock
                        x:Name="CompletionToolTip"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        MaxLines="12"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Border>
            </Popup>

            <!--
                Commands can be run while others are running; each is stopped from its own item.
                The button runs the command, and its menu runs it as an administrator, which the user is asked to allow the first time, or queues it.
                The shortcuts are shown rather than registered, as they are handled by the input.
            -->
            <SplitButton
                Grid.Row="1"
                Height="40"
                Margin="0,0,8,8"
                Padding="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Run"
                Command="{x:Bind Session.RunCommand, Mode=OneWay}"
                ToolTipService.ToolTip="Run (Enter)">
                <FontIcon FontSize="16" Glyph="&#xE724;" />
                <SplitButton.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuFlyoutItem
                            Command="{x:Bind Session.RunCommand, Mode=OneWay}"
                            KeyboardAcceleratorTextOverride="Enter"
                            Text="Run">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind Session.RunElevatedCommand, Mode=OneWay}"
                            KeyboardAcceleratorTextOverride="Ctrl+Shift+Enter"
                            Text="Run as administrator">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEA18;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind Session.EnqueueCommand, Mode=OneWay}"
                            KeyboardAcceleratorTextOverride="Ctrl+Enter"
                            Text="Queue">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE823;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>

        <!--  Saved scripts, each run with a single click, and edited or deleted from its menu.  -->
        <Grid
            x:Name="ScriptsPane"
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="280"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="20,24,12,12">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Scripts" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Save script"
                    Click="OnAddScriptClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Save a script; what is typed in the input is filled in">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="8,0,8,12">
                <ItemsRepeater ElementPrepared="OnScriptElementPrepared" ItemsSource="{x:Bind Session.Scripts, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedScript">
                            <!--  The menu is on the item rather than the button, so it is available whatever the state of the button.  -->
                            <Grid>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="OnRunScriptClick"
                                            Tag="{x:Bind}"
                                            Text="Run">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="OnRunScriptElevatedClick"
                                            Tag="{x:Bind}"
                                            Text="Run as administrator">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEA18;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="OnEnqueueScriptClick"
                                            Tag="{x:Bind}"
                                            Text="Queue">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE823;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="OnLoadScriptClick"
                                            Tag="{x:Bind}"
                                            Text="Load">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Click="OnCopyScriptClick"
                                            Tag="{x:Bind}"
                                            Text="Copy">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="OnEditScriptClick"
                                            Tag="{x:Bind}"
                                            Text="Edit">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="OnDeleteScriptClick"
                                            Tag="{x:Bind}"
                                            Text="Delete">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <!--  Its command is the session's, set when the item is prepared.  -->
                                <Button
                                    Padding="12,8,40,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Click="OnScriptButtonClick"
                                    CommandParameter="{x:Bind}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind Command}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Margin="0,3,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="12"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE768;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonospaceFontFamily}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Command}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button
                                    Margin="0,4,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{x:Bind local:Bind.Format('More options for {0}', Name)}"
                                    Click="OnScriptMoreClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="More options">
                                    <FontIcon FontSize="12" Glyph="&#xE712;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock
                Grid.Row="1"
                Margin="20,0,20,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Save commands you run often, and run them here with a single click."
                TextWrapping="Wrap"
                Visibility="{x:Bind local:Bind.CollapsedIf(Session.HasScripts), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
