<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Client.WinUI3.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Client.WinUI3.Controls"
    xmlns:local="using:App.Client.WinUI3.Views"
    xmlns:models="using:App.Domain"
    xmlns:services="using:App.Services"
    xmlns:vm="using:App.Client.WinUI3.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="CommandEntryTemplate" x:DataType="vm:CommandEntryViewModel">
            <!--  As a cell of a notebook: the command, and below it what it wrote, on a single card.  -->
            <Border
                Margin="0,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  The command, with when it was started, and the command copied or run again, and the output collapsed beside it; pinned, saved or removed from its menu (the command text keeps its own).  -->
                    <Grid
                        Padding="14,6,6,6"
                        Background="Transparent"
                        ColumnSpacing="8">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="OnEntryMenuOpening">
                                <MenuFlyoutItem Command="{x:Bind TogglePinnedCommand}" Text="{x:Bind PinToolTip, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE718;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnSaveAsScriptClick"
                                    Tag="{x:Bind}"
                                    Text="Save as script">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <!--  Compared with the run before of the same command, or with any other selected first, once it has ended; shown as they can be when the menu is opened.  -->
                                <MenuFlyoutSeparator Visibility="{x:Bind IsCompleted, Mode=OneWay}" />
                                <MenuFlyoutItem
                                    x:Name="CompareWithPreviousRunItem"
                                    Click="OnCompareWithPreviousRunClick"
                                    Tag="{x:Bind}"
                                    Text="Compare with previous run">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE89A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="SelectForComparisonItem"
                                    Click="OnSelectForComparisonClick"
                                    Tag="{x:Bind}"
                                    Text="Select for compare" />
                                <MenuFlyoutItem
                                    x:Name="CompareWithSelectedItem"
                                    Click="OnCompareWithSelectedClick"
                                    Tag="{x:Bind}"
                                    Text="Compare with selected" />
                                <MenuFlyoutSeparator Visibility="{x:Bind IsCompleted, Mode=OneWay}" />
                                <MenuFlyoutItem
                                    Click="OnRemoveEntryClick"
                                    Tag="{x:Bind}"
                                    Text="Remove from history"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RichTextBlock
                            x:Name="CommandText"
                            Margin="0,4"
                            controls:SyntaxHighlighting.Code="{x:Bind HighlightedCommand, Mode=OneWay}"
                            FontFamily="{StaticResource MonospaceFontFamily}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="0">
                            <FontIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Run as administrator"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xEA18;"
                                ToolTipService.ToolTip="Run as administrator"
                                Visibility="{x:Bind IsElevated}" />
                            <TextBlock
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind StartedAtText}"
                                ToolTipService.ToolTip="{x:Bind StartedAtToolTip}" />
                            <FontIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Pinned"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE841;"
                                ToolTipService.ToolTip="Pinned"
                                Visibility="{x:Bind IsPinned, Mode=OneWay}" />
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Copy command"
                                Command="{x:Bind CopyInputCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Copy command">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Run again"
                                Command="{x:Bind RerunCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Run again">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind ExpandToolTip, Mode=OneWay}"
                                Command="{x:Bind ToggleExpandedCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ExpandToolTip, Mode=OneWay}"
                                Visibility="{x:Bind HasOutput, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  What it wrote, with the standard error in red, as it is written; and below it, how it ended.  -->
                    <StackPanel
                        Grid.Row="2"
                        Padding="14,10,14,6"
                        Spacing="8">
                        <!--
                            The line numbers beside the output, when they are shown, as set by the view; laid out in rows as high as those of the output,
                            and scrolled vertically along with it, but kept in view when it is scrolled horizontally.
                        -->
                        <Grid Visibility="{x:Bind IsOutputVisible, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer
                                x:Name="LineNumbersScroller"
                                AutomationProperties.AccessibilityView="Raw"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                VerticalScrollBarVisibility="Hidden"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="LineNumbersText"
                                    Margin="0,0,12,0"
                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    LineHeight="18"
                                    LineStackingStrategy="BlockLineHeight"
                                    TextAlignment="Right" />
                            </ScrollViewer>

                            <!--  Scrolled horizontally only when long lines aren't wrapped, and vertically only when its height is limited, as set by the view.  -->
                            <ScrollViewer
                                x:Name="OutputScroller"
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <RichTextBlock
                                    x:Name="OutputText"
                                    controls:TerminalOutput.Output="{x:Bind DisplayedOutput, Mode=OneWay}"
                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                    FontSize="13"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="18"
                                    LineStackingStrategy="BlockLineHeight"
                                    SizeChanged="OnOutputTextSizeChanged"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="No matching lines"
                            Visibility="{x:Bind IsNoMatchingLinesVisible, Mode=OneWay}" />

                        <!--  How it ended, and how long it took.  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind IsSucceeded, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE711;"
                                Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}" />
                            <ProgressBar
                                Width="120"
                                VerticalAlignment="Center"
                                IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                Maximum="100"
                                ShowError="{x:Bind IsProgressError, Mode=OneWay}"
                                ShowPaused="{x:Bind IsProgressPaused, Mode=OneWay}"
                                Visibility="{x:Bind IsProgressVisible, Mode=OneWay}"
                                Value="{x:Bind ProgressValue, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="·" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind DurationText, Mode=OneWay}" />
                            <Button
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Stop"
                                Command="{x:Bind StopCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Stop"
                                Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE71A;" />
                            </Button>
                            <Button
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Copy output"
                                Command="{x:Bind CopyCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Copy output"
                                Visibility="{x:Bind HasOutput, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                Margin="-8,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Save output to file"
                                Click="OnSaveOutputClick"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Save output to file"
                                Visibility="{x:Bind HasOutput, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE74E;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Header  -->
        <Grid
            Padding="32,20,24,12"
            ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Session.Project.DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Session.Project.TerminalDisplayName, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Session.Project.LocationDisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <ToggleButton
                    x:Name="SearchToggleButton"
                    AutomationProperties.Name="Search history"
                    Click="OnToggleSearchClick"
                    Style="{StaticResource IconToggleButtonStyle}"
                    ToolTipService.ToolTip="Search history">
                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                </ToggleButton>
                <Button
                    AutomationProperties.Name="Open working folder"
                    Click="OnOpenFolderClick"
                    Visibility="{x:Bind Session.IsWorkingFolderLocal, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Open working folder">
                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                </Button>
                <Button
                    x:Name="ScriptsToggleButton"
                    AutomationProperties.Name="Hide scripts"
                    Click="OnToggleScriptsClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Hide scripts">
                    <FontIcon
                        x:Name="ScriptsToggleIcon"
                        FontSize="16"
                        Glyph="&#xE89F;" />
                </Button>
                <Button
                    AutomationProperties.Name="More options"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="More options">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind Session.ClearUnpinnedCommand, Mode=OneWay}" Text="Clear history except pinned">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE718;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Session.ClearCommand, Mode=OneWay}" Text="Clear history">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE894;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnEditProjectClick" Text="Edit project">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnDeleteProjectClick" Text="Delete project">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!--  What is searched for in the history, while the search is on.  -->
            <Grid
                x:Name="SearchPanel"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                ColumnSpacing="4"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search history"
                    KeyDown="OnSearchBoxKeyDown"
                    PlaceholderText="Search history"
                    TextChanged="OnSearchTextChanged" />
                <ToggleButton
                    x:Name="CaseSensitiveToggleButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Match case"
                    Click="OnSearchOptionClick"
                    Style="{StaticResource IconToggleButtonStyle}"
                    ToolTipService.ToolTip="Match case">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Aa" />
                </ToggleButton>
                <ToggleButton
                    x:Name="RegexToggleButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Use regular expression"
                    Click="OnSearchOptionClick"
                    Style="{StaticResource IconToggleButtonStyle}"
                    ToolTipService.ToolTip="Use regular expression">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text=".*" />
                </ToggleButton>
                <ToggleButton
                    x:Name="FilterLinesToggleButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Show only matching lines"
                    Click="OnSearchOptionClick"
                    Style="{StaticResource IconToggleButtonStyle}"
                    ToolTipService.ToolTip="Show only matching lines">
                    <FontIcon FontSize="16" Glyph="&#xE71C;" />
                </ToggleButton>
            </Grid>
        </Grid>

        <!--  History; anchored to the bottom, so output that is being written stays in view.  -->
        <ScrollViewer
            x:Name="HistoryScroller"
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            VerticalAnchorRatio="1"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                x:Name="HistoryRepeater"
                Margin="32,0,32,12"
                ElementPrepared="OnEntryElementPrepared"
                ItemTemplate="{StaticResource CommandEntryTemplate}"
                ItemsSource="{x:Bind Session.Entries, Mode=OneWay}" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:Bind.CollapsedIf(Session.HasEntries), Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Run a command" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Type a command below, and it is run in the working folder of the project. Its output is shown here as it is written."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Composer; the text box carries the border, and the buttons sit on top of it. The commands queued are listed above it.  -->
        <Grid
            Grid.Row="2"
            Padding="32,8,32,20"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4" Visibility="{x:Bind Session.HasQueue, Mode=OneWay}">
                <TextBlock
                    Margin="4,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Queued — each is run once the commands running have ended" />
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater ItemsSource="{x:Bind Session.Queue, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueuedCommand">
                                <Grid
                                    Padding="12,2,4,2"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="10"
                                    CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE823;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource MonospaceFontFamily}"
                                        Text="{x:Bind Command}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Command}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Cancel"
                                        Click="OnCancelQueuedClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Cancel">
                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>

            <TextBox
                Grid.Row="1"
                x:Name="InputBox"
                MinHeight="56"
                MaxHeight="200"
                Padding="12,17,96,10"
                AcceptsReturn="True"
                AutomationProperties.Name="Command"
                CornerRadius="12"
                FontFamily="{StaticResource MonospaceFontFamily}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                PlaceholderText="Type a command"
                LostFocus="OnInputLostFocus"
                PreviewKeyDown="OnInputPreviewKeyDown"
                SelectionChanged="OnInputSelectionChanged"
                Text="{x:Bind Session.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <!--
                The matches the text before the caret can be completed to, opened by Ctrl+Space above the text completed.
                The focus is left on the input, which moves through the matches with the arrow keys, so the list is never focused, not even by a click.
            -->
            <Popup
                x:Name="CompletionPopup"
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Border
                    Width="420"
                    Padding="0,4"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <ListView
                        x:Name="CompletionList"
                        MaxHeight="280"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Completions"
                        IsItemClickEnabled="True"
                        IsTabStop="False"
                        ItemClick="OnCompletionItemClick"
                        Loaded="OnCompletionListLoaded"
                        SelectionChanged="OnCompletionSelectionChanged"
                        SelectionMode="Single">
                        <!--  refreshed on each key typed, so the matches are replaced at once, not animated in  -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:CompletionMatch">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ImageIcon
                                        Width="16"
                                        Height="16"
                                        Source="{x:Bind local:Bind.CompletionIcon(ResultType)}" />
                                    <TextBlock
                                        controls:CompletionHighlighting.Match="{x:Bind}"
                                        FontFamily="{StaticResource MonospaceFontFamily}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Popup>

            <!--  What the match selected is, such as the syntax of a command, or the full path of a file, beside it, as Visual Studio shows it.  -->
            <Popup x:Name="CompletionInfoPopup" DesiredPlacement="RightEdgeAlignedTop">
                <Border
                    MaxWidth="400"
                    Margin="8,0,0,0"
                    Padding="12,8"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <TextBlock
                        x:Name="CompletionToolTip"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        MaxLines="12"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Border>
            </Popup>

            <!--
                Commands can be run while others are running; each is stopped from its own item.
                The button runs the command, and its menu runs it as an administrator, which the user is asked to allow the first time, or queues it.
                The shortcuts are shown rather than registered, as they are handled by the input.
            -->
            <SplitButton
                Grid.Row="1"
                Height="40"
                Margin="0,0,8,8"
                Padding="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Run"
                Command="{x:Bind Session.RunCommand, Mode=OneWay}"
                ToolTipService.ToolTip="Run (Enter)">
                <FontIcon FontSize="16" Glyph="&#xE724;" />
                <SplitButton.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuFlyoutItem
                            Command="{x:Bind Session.RunCommand, Mode=OneWay}"
                            KeyboardAcceleratorTextOverride="Enter"
                            Text="Run">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind Session.RunElevatedCommand, Mode=OneWay}"
                            KeyboardAcceleratorTextOverride="Ctrl+Shift+Enter"
                            Visibility="{x:Bind Session.CanRunElevated, Mode=OneWay}"
                            Text="Run as administrator">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEA18;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind Session.EnqueueCommand, Mode=OneWay}"
                            KeyboardAcceleratorTextOverride="Ctrl+Enter"
                            Text="Queue">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE823;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>

        <!--  Scripts, saved to the project or read from files in its working folder, each run with a single click, and edited or deleted from its menu.  -->
        <Grid
            x:Name="ScriptsPane"
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="280"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="20,24,12,12">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Scripts" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ToggleButton
                        x:Name="ScriptSearchToggleButton"
                        AutomationProperties.Name="Search scripts"
                        Click="OnToggleScriptSearchClick"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="Search scripts">
                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                    </ToggleButton>
                    <Button
                        AutomationProperties.Name="Save script"
                        Click="OnAddScriptClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Save a script; what is typed in the input is filled in">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  What the scripts are filtered by, in their names and commands, while the search is on.  -->
            <TextBox
                x:Name="ScriptSearchBox"
                Grid.Row="1"
                Margin="16,0,16,12"
                AutomationProperties.Name="Search scripts"
                KeyDown="OnScriptSearchBoxKeyDown"
                PlaceholderText="Search scripts"
                Text="{x:Bind Session.ScriptFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="Collapsed" />

            <!--  The scripts by where they are from, each group with its name above it, which collapses it, once there is more than one.  -->
            <ScrollViewer Grid.Row="2" Padding="8,0,8,12">
                <ItemsRepeater x:Name="ScriptGroupsRepeater" ItemsSource="{x:Bind Session.ScriptGroups, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScriptGroupViewModel">
                            <!--  Spaced by its margin, as the spacing of the layout would be left for a group that is hidden too.  -->
                            <StackPanel
                                Margin="0,0,0,8"
                                Spacing="2"
                                Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                <Grid Visibility="{x:Bind IsHeaderVisible, Mode=OneWay}">
                                    <Button
                                        Padding="8,6,36,6"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind ExpandLabel, Mode=OneWay}"
                                        Command="{x:Bind ToggleExpandedCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind FilePath}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                    <!--  A file can be opened, to change its scripts there.  -->
                                    <Button
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind local:Bind.Format('Open {0}', FilePath)}"
                                        Click="OnOpenScriptFileClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Open file"
                                        Visibility="{x:Bind local:Bind.VisibleIf(IsReadOnly)}">
                                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                    </Button>
                                </Grid>

                                <!--  Why the scripts couldn't be read from the file, as it is until it is fixed.  -->
                                <TextBlock
                                    Margin="12,0,12,4"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Error, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind IsErrorVisible, Mode=OneWay}" />

                                <ItemsRepeater
                                    x:Name="GroupScriptsRepeater"
                                    ElementPrepared="OnScriptElementPrepared"
                                    ItemsSource="{x:Bind FilteredScripts}"
                                    Visibility="{x:Bind IsContentVisible, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScriptItem">
                                            <!--  The menu is on the item rather than the button, so it is available whatever the state of the button.  -->
                                            <Grid>
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            Click="OnRunScriptClick"
                                                            Tag="{x:Bind}"
                                                            Text="Run">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE768;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Click="OnRunScriptElevatedClick"
                                                            Tag="{x:Bind}"
                                                            Text="Run as administrator">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xEA18;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Click="OnEnqueueScriptClick"
                                                            Tag="{x:Bind}"
                                                            Text="Queue">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE823;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Click="OnLoadScriptClick"
                                                            Tag="{x:Bind}"
                                                            Text="Load">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE77F;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem
                                                            Click="OnCopyScriptClick"
                                                            Tag="{x:Bind}"
                                                            Text="Copy script">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8C8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <!--  For a script read from a file, the copy is saved to the project, where it can be changed.  -->
                                                        <MenuFlyoutItem
                                                            Click="OnDuplicateScriptClick"
                                                            Tag="{x:Bind}"
                                                            Text="Duplicate script"
                                                            Visibility="{x:Bind local:Bind.CollapsedIf(Group.IsReadOnly)}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8A5;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Click="OnDuplicateScriptClick"
                                                            Tag="{x:Bind}"
                                                            Text="Save to project"
                                                            Visibility="{x:Bind local:Bind.VisibleIf(Group.IsReadOnly)}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74E;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Click="OnEditScriptClick"
                                                            Tag="{x:Bind}"
                                                            Text="Edit"
                                                            Visibility="{x:Bind local:Bind.CollapsedIf(Group.IsReadOnly)}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Click="OnDeleteScriptClick"
                                                            Tag="{x:Bind}"
                                                            Text="Delete"
                                                            Visibility="{x:Bind local:Bind.CollapsedIf(Group.IsReadOnly)}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Click="OnOpenScriptFileClick"
                                                            Tag="{x:Bind Group}"
                                                            Text="Open file"
                                                            Visibility="{x:Bind local:Bind.VisibleIf(Group.IsReadOnly)}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8A7;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>

                                                <!--  Its command is the session's, set when the item is prepared.  -->
                                                <Button
                                                    Padding="12,8,40,8"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.Name="{x:Bind Script.Name}"
                                                    Click="OnScriptButtonClick"
                                                    CommandParameter="{x:Bind Script}"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind Script.Command}">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon
                                                            Margin="0,3,0,0"
                                                            VerticalAlignment="Top"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Glyph="&#xE768;" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock
                                                                x:Name="ScriptNameText"
                                                                Text="{x:Bind Script.Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                x:Name="ScriptCommandText"
                                                                FontFamily="{StaticResource MonospaceFontFamily}"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                MaxLines="2"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind Script.Summary}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button
                                                    Margin="0,4,4,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.Name="{x:Bind local:Bind.Format('More options for {0}', Script.Name)}"
                                                    Click="OnScriptMoreClick"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTipService.ToolTip="More options">
                                                    <FontIcon FontSize="12" Glyph="&#xE712;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock
                Grid.Row="2"
                Margin="20,0,20,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Save commands you run often, and run them here with a single click."
                TextWrapping="Wrap"
                Visibility="{x:Bind local:Bind.CollapsedIf(Session.HasScripts), Mode=OneWay}" />

            <TextBlock
                Grid.Row="2"
                Margin="20,0,20,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="No scripts match the search."
                TextWrapping="Wrap"
                Visibility="{x:Bind Session.HasNoScriptMatches, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
