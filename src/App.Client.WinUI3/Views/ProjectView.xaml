<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Client.WinUI3.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Client.WinUI3.Controls"
    xmlns:local="using:App.Client.WinUI3.Views"
    xmlns:vm="using:App.Client.WinUI3.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="CommandEntryTemplate" x:DataType="vm:CommandEntryViewModel">
            <StackPanel Margin="0,10" Spacing="6">

                <!--  The command, on the right, as what the user said in a chat.  -->
                <Border
                    MaxWidth="720"
                    Padding="14,10"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="14,14,4,14">
                    <TextBlock
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Command}"
                        TextWrapping="Wrap" />
                </Border>

                <!--  What it wrote, with the standard error in red, as it is written.  -->
                <Border
                    Padding="14,10"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind HasOutput, Mode=OneWay}">
                    <RichTextBlock
                        controls:TerminalOutput.Segments="{x:Bind Segments}"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        FontSize="13"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </Border>

                <!--  How it ended, and how long it took.  -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind IsRunning, Mode=OneWay}"
                        Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind IsSucceeded, Mode=OneWay}" />
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE711;"
                        Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="·" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind DurationText, Mode=OneWay}" />
                    <Button
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Copy output"
                        Command="{x:Bind CopyCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Copy output"
                        Visibility="{x:Bind HasOutput, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            Padding="32,20,24,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Session.Project.DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Session.Project.TerminalDisplayName, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Session.Project.WorkingFolder, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    AutomationProperties.Name="Open working folder"
                    Click="OnOpenFolderClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Open working folder">
                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                </Button>
                <Button
                    AutomationProperties.Name="Clear history"
                    Command="{x:Bind Session.ClearCommand, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Clear history">
                    <FontIcon FontSize="16" Glyph="&#xE894;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  History; anchored to the bottom, so output that is being written stays in view.  -->
        <ScrollViewer
            x:Name="HistoryScroller"
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            VerticalAnchorRatio="1"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                Margin="32,0,32,12"
                ItemTemplate="{StaticResource CommandEntryTemplate}"
                ItemsSource="{x:Bind Session.Entries, Mode=OneWay}" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:Bind.CollapsedIf(Session.HasEntries), Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Run a command" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Type a command below, and it is run in the working folder of the project. Its output is shown here as it is written."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Composer; the text box carries the border, and the buttons sit on top of it.  -->
        <Grid Grid.Row="2" Padding="32,8,32,20">
            <TextBox
                x:Name="InputBox"
                MinHeight="56"
                MaxHeight="200"
                Padding="12,17,60,10"
                AcceptsReturn="True"
                AutomationProperties.Name="Command"
                CornerRadius="12"
                FontFamily="{StaticResource MonospaceFontFamily}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                PlaceholderText="Type a command — Enter to run, Shift+Enter for a new line"
                PreviewKeyDown="OnInputPreviewKeyDown"
                Text="{x:Bind Session.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <!--  Run and stop stand in for each other.  -->
            <Grid
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <Button
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="Run"
                    Command="{x:Bind Session.RunCommand, Mode=OneWay}"
                    CornerRadius="10"
                    Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Run (Enter)"
                    Visibility="{x:Bind local:Bind.CollapsedIf(Session.IsRunning), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE724;" />
                </Button>
                <Button
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="Stop"
                    Command="{x:Bind Session.StopCommand, Mode=OneWay}"
                    CornerRadius="10"
                    ToolTipService.ToolTip="Stop (Ctrl+C)"
                    Visibility="{x:Bind local:Bind.VisibleIf(Session.IsRunning), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE71A;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
