<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="App.Client.WinUI3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The colors of a script, as Visual Studio colors it; plain in high contrast, as the system colors of text are all there is. And the colors of what is found by a search, as a browser marks it.
                And the colors of a comparison: the lines removed and added, and the parts of them that were changed, more strongly; in high contrast only the parts changed, highlighted as selected text is.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#0000FF" />
                    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#008000" />
                    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#A31515" />
                    <SolidColorBrush x:Key="SyntaxTypeNameBrush" Color="#2B91AF" />
                    <SolidColorBrush x:Key="SearchHighlightBackgroundBrush" Color="#FFE066" />
                    <SolidColorBrush x:Key="SearchHighlightForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="DiffRemovedLineBrush" Color="#FFEBE9" />
                    <SolidColorBrush x:Key="DiffAddedLineBrush" Color="#E6FFEC" />
                    <SolidColorBrush x:Key="DiffRemovedHighlightBrush" Color="#FFC0BE" />
                    <SolidColorBrush x:Key="DiffAddedHighlightBrush" Color="#ABF2BC" />
                    <SolidColorBrush x:Key="DiffHighlightForegroundBrush" Color="#1F2328" />
                    <SolidColorBrush x:Key="DiffFillerBrush" Color="#08000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#569CD6" />
                    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#57A64A" />
                    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#D69D85" />
                    <SolidColorBrush x:Key="SyntaxTypeNameBrush" Color="#4EC9B0" />
                    <SolidColorBrush x:Key="SearchHighlightBackgroundBrush" Color="#F2CC60" />
                    <SolidColorBrush x:Key="SearchHighlightForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="DiffRemovedLineBrush" Color="#1FF85149" />
                    <SolidColorBrush x:Key="DiffAddedLineBrush" Color="#262EA043" />
                    <SolidColorBrush x:Key="DiffRemovedHighlightBrush" Color="#66F85149" />
                    <SolidColorBrush x:Key="DiffAddedHighlightBrush" Color="#662EA043" />
                    <SolidColorBrush x:Key="DiffHighlightForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DiffFillerBrush" Color="#0AFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SyntaxStringBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SyntaxTypeNameBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SearchHighlightBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SearchHighlightForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="DiffRemovedLineBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="DiffAddedLineBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="DiffRemovedHighlightBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DiffAddedHighlightBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DiffHighlightForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="DiffFillerBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!--  A button of only an icon, which shows its background only while hovered or pressed.  -->
            <Style
                x:Key="IconButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!--  The same, for a button that stays pressed, which shows the accent color while it is.  -->
            <Style
                x:Key="IconToggleButtonStyle"
                BasedOn="{StaticResource DefaultToggleButtonStyle}"
                TargetType="ToggleButton">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
