<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppDirectory>..\..\src\App.Client.WinUI3\</AppDirectory>
  </PropertyGroup>

  <!-- A WinUI app can't be referenced by another project, so the code measured, which doesn't depend on WinUI, is compiled in from it. -->
  <ItemGroup>
    <Compile Include="$(AppDirectory)Controls\OutputRunBuilder.cs" Link="App\Controls\OutputRunBuilder.cs" />
    <Compile Include="$(AppDirectory)ViewModels\CommandOutput.cs" Link="App\ViewModels\CommandOutput.cs" />
    <Compile Include="$(AppDirectory)Services\UrlDetector.cs" Link="App\Services\UrlDetector.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App.Domain\App.Domain.csproj" />
    <ProjectReference Include="..\..\src\App.Services\App.Services.csproj" />
  </ItemGroup>

</Project>
